# Aplikasi
APP_NAME=Poinqu API
APP_VERSION=0.2.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/v1
# Kosongkan untuk menonaktifkan pengecekan versi minimum
MIN_APP_VERSION=
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Database (lokal/SQLite). Docker compose memakai PostgreSQL otomatis.
DATABASE_URL=sqlite+pysqlite:///./poinqu.db
AUTO_CREATE_TABLES=true
# Kosong = revocation store in-memory (dev). Isi di produksi, mis. redis://localhost:6379/0
REDIS_URL=

# Token
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
VERIFICATION_TOKEN_TTL=600
PIN_TOKEN_TTL=120
CHALLENGE_TTL=120

# OTP
# Kosong = otomatis: fonnte bila FONNTE_TOKEN diisi, selain itu log.
OTP_PROVIDER=
OTP_TTL=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=30
OTP_MAX_RESENDS=3
OTP_HOURLY_LIMIT=5
# Hanya development: cetak kode OTP ke log. JANGAN aktifkan di produksi.
OTP_DEV_ECHO=false

# Fonnte (WhatsApp gateway)
FONNTE_TOKEN=
FONNTE_BASE_URL=https://api.fonnte.com
FONNTE_TIMEOUT_SECONDS=8
FONNTE_WEBHOOK_SECRET=
FONNTE_ALLOWED_IPS=

# Email SMTP (OTP email & notifikasi)
# Kosong = otomatis: SMTP bila SMTP_HOST diisi, selain itu gateway log.
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@poinqu.id
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
EMAIL_OTP_SUBJECT=Kode verifikasi Poinqu
EMAIL_OTP_TEMPLATE=Kode verifikasi Poinqu kamu adalah {code}. Berlaku {minutes} menit.
Jangan berikan kode ini ke siapa pun, termasuk yang mengaku dari Poinqu.

# PIN & biometrik
PIN_MAX_FAILED=5
PIN_LOCK_SECONDS=900
BIOMETRIC_MAX_FAILED=5
BIOMETRIC_LOCK_SECONDS=900

# Pemulihan nomor
RECOVERY_TTL=900
RECOVERY_MAX_ATTEMPTS=3

# Avatar
AVATAR_DIR=media/avatars
AVATAR_MAX_BYTES=5242880
MEDIA_BASE_URL=http://localhost:8000

# Admin awal (dibuat saat startup bila tabel admins kosong).
# Isi ADMIN_TOTP_SECRET dengan base32 dari authenticator; bila kosong,
# secret diacak dan ditulis ke log startup.
ADMIN_NAME=Superadmin
ADMIN_EMAIL=owner@poinqu.id
ADMIN_PASSWORD=admin-password-123
ADMIN_TOTP_SECRET=
ADMIN_LOCK_SECONDS=900
ADMIN_MAX_FAILED=5
ADMIN_2FA_TTL=300

# PostgreSQL (dipakai compose)
POSTGRES_USER=poinqu
POSTGRES_PASSWORD=poinqu
POSTGRES_DB=poinqu
PORT=8000
